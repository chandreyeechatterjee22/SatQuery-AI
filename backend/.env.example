# Copy to backend/.env and fill in. Never commit .env.

# Google Earth Engine project id (defaults to satquery-ai-508105 if unset)
GEE_PROJECT_ID=satquery-ai-508105

# Optional service-account auth. Leave both empty to use `earthengine authenticate`.
# GEE_PRIVATE_KEY is the path to the service account's JSON key file.
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY=

# --- Upload-based flow ---
# Where accepted uploads are stored (default: <repo>/data/uploads, git-ignored)
UPLOAD_DIR=
# Per-file upload size limit in MB (default 500)
MAX_UPLOAD_MB=500

# --- Local models (upload-based flow) ---
# Where model weights are cached (default: <repo>/data/models, git-ignored)
MODEL_CACHE_DIR=
# Override individual files (defaults live under MODEL_CACHE_DIR)
REMOTECLIP_CHECKPOINT=
VQA_HEAD_PATH=
