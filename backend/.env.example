# Copy to backend/.env and fill in. Never commit .env.

# Google Earth Engine project id (defaults to satquery-ai-508105 if unset)
GEE_PROJECT_ID=satquery-ai-508105

# Optional service-account auth. Leave both empty to use `earthengine authenticate`.
# GEE_PRIVATE_KEY is the path to the service account's JSON key file.
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY=
